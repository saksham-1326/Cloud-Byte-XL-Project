# Copy only the settings you need into backend/.env. Never commit real secrets.
# Existing PostgreSQL settings may already be supplied by the environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bytexl
DB_USER=postgres
DB_PASSWORD=
GITHUB_TOKEN=
# Optional CI callback authentication. Match the GitHub CI_STATUS_TOKEN secret.
# Configure this on a remotely exposed Flask server before enabling callbacks.
CI_STATUS_TOKEN=
# Durable callbacks also require an explicit repository allowlist.
CI_ALLOWED_REPOSITORIES=
# Keep external delivery disabled; do not configure a public callback URL.
CI_CALLBACK_ENABLED=0

# Restrict API/webhook access to explicitly configured repositories.
AI_ALLOWED_REPOSITORIES=saksham-1326/cloud-byte-xl-project
# Optional for loopback access; required for remotely exposed AI administration.
AI_ADMIN_TOKEN=
# Required only when configuring the dedicated workflow_run webhook.
GITHUB_WEBHOOK_SECRET=

# none = clearly labeled evidence-rule diagnostics, not LLM-generated RCA.
# openai = OpenAI Responses; gemini = Gemini Developer API (no fallback).
RCA_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini free-tier text models reviewed 2026-11-15: gemini-3.5-flash-lite,
# gemini-2.5-flash-lite, gemini-2.5-flash. The 2.5 models rejected generation
# for this project (HTTP 404). Select explicitly; quota is project-specific.
# Select an available model that supports Structured Outputs. No model is assumed.
RCA_MODEL=
FLASK_DEBUG=0
