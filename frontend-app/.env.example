# Public configuration only. Never put credentials in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:5000
# Production uses https://cloud-bytexl-api.onrender.com on Vercel Hobby.
# Public demo is read-only; hosted AI sync/training is handled by Render's restricted worker.
VITE_ENABLE_ADMIN_ACTIONS=false
VITE_ENABLE_MODEL_TRAINING=false
VITE_ENABLE_LIVE_PREDICTIONS=false
VITE_ENABLE_PROVIDER_CALLS=false
