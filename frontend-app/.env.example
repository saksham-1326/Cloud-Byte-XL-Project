# Public configuration only. Never put tokens, passwords or provider keys here.
VITE_API_BASE_URL=http://127.0.0.1:5000
# Development only above. Production build REQUIRES an explicit HTTPS backend
# origin, for example https://your-approved-service.onrender.com (no /api suffix).
# Keep these off for the delivery audit/read-only demonstration.
VITE_ENABLE_MODEL_TRAINING=false
VITE_ENABLE_LIVE_PREDICTIONS=false
VITE_ENABLE_PROVIDER_CALLS=false
